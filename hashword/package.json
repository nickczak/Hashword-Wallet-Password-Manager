{
  "name": "hashword",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "bin": {
    "hashword": "dist/index.js"
  },
  "files": [
    "dist",
    "public/assets/banner.txt"
  ],
  "scripts": {
    "dev": "node --watch --import=tsx src/index.tsx",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
